{
  "name": "@zupertools/modal-core",
  "version": "0.1.0",
  "description": "Framework-agnostic core for zupermodal",
  "keywords": [
    "dialog",
    "modal",
    "zupermodal"
  ],
  "license": "MIT",
  "author": "Theodor Lundin",
  "repository": {
    "url": "https://github.com/zupertools/zupermodal/"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest"
  },
  "devDependencies": {
    "jsdom": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
